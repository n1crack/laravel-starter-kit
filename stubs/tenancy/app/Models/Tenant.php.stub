<?php

declare(strict_types=1);

namespace App\Models;

use Database\Factories\TenantFactory;
use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Relations\HasMany;
use Stancl\Tenancy\Contracts\TenantWithDatabase;
use Stancl\Tenancy\Database\Concerns\HasDatabase;
use Stancl\Tenancy\Database\Concerns\HasDomains;
use Stancl\Tenancy\Database\Models\Domain;
use Stancl\Tenancy\Database\Models\Tenant as BaseTenant;

/**
 * Tenants are created and administered by a separate application; this one
 * only ever reads them to resolve the request's tenant.
 */
final class Tenant extends BaseTenant implements TenantWithDatabase
{
    /**
     * @use HasFactory<TenantFactory>
     */
    use HasDatabase, HasDomains, HasFactory;

    /**
     * The package's own `domains()` is untyped, which leaves every call on it
     * as `mixed` under static analysis.
     *
     * @return HasMany<Domain, $this>
     */
    public function domains(): HasMany
    {
        return $this->hasMany(Domain::class, 'tenant_id');
    }
}
