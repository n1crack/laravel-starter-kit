includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - public
        - routes


    level: max

    excludePaths:
        # Vendor-published migration stub; not written for level max.
        - database/migrations/*_create_permission_tables.php

    tmpDir: /tmp/phpstan
